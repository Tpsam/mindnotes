# Mindnotes Environment Variables
# Copy to ~/Mindnotes/.env or .env in project root

# Notion Integration
NOTION_API_KEY=ntn_...
NOTION_NOTES_DB_ID=...
NOTION_CONTENT_DB_ID=...

# LLM Providers (At least one is required)
# Supports Anthropic, OpenAI, Gemini, DeepSeek
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
